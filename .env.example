# Flask
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value
BACKEND_URL=http://127.0.0.1:5000
FRONTEND_URL=http://127.0.0.1:5173
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:5000
NEXT_PUBLIC_BUSINESS_NAME=Shield Pharmacy
NEXT_PUBLIC_BUSINESS_PHONE=+254 700 123 456
NEXT_PUBLIC_BUSINESS_PHONE_HREF=+254700123456
NEXT_PUBLIC_BUSINESS_EMAIL=care@shieldpharmacy.co.ke
NEXT_PUBLIC_BUSINESS_ADDRESS=Nairobi, Kenya
NEXT_PUBLIC_BUSINESS_HOURS=Mon-Sat, 8:00-20:00
NEXT_PUBLIC_WHATSAPP_NUMBER=254700123456
NEXT_PUBLIC_MAP_QUERY=Nairobi, Kenya

# MySQL
DATABASE_URL=mysql+pymysql://shield_user:strong-password@127.0.0.1:3306/shield_pharmacy

# Mail
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=care@shieldpharmacy.co.ke

# Payments (disabled until configured)
MPESA_ENABLED=false
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.example/api/v1/payments/mpesa/callback

# Security and observability
RATELIMIT_STORAGE_URI=memory://
SENTRY_DSN=
SESSION_COOKIE_SECURE=false
